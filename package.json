{
  "name": "oction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A live auction house for physical goods. Atomic bids, no sniping, a log you can check.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,workers,web -c cyan,yellow,magenta \"npm:dev:api\" \"npm:dev:workers\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:workers": "node --watch --env-file-if-exists=.env src/queue/run.js",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=.env src/server.js",
    "workers": "node --env-file-if-exists=.env src/queue/run.js",
    "build": "vite build",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.js",
    "loadtest": "npm run loadtest:prepare && node loadtest/storm.mjs && node loadtest/verify.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "mongo:dev": "node src/scripts/mongo-dev.mjs",
    "loadtest:prepare": "node --env-file-if-exists=.env loadtest/prepare.mjs",
    "loadtest:k6": "k6 run loadtest/bid-storm.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.63.0",
    "cloudinary": "^2.7.0",
    "express": "^5.2.1",
    "ioredis": "^5.9.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^10.2.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "vite": "^8.3.0",
    "vitest": "^2.1.8"
  }
}
