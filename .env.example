# Copy to .env. Everything here has a working default except the secret.
PORT=4200
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/oction
REDIS_URL=redis://127.0.0.1:6379

# Sign your own. A shared development secret in production means anyone
# can mint a session for anyone.
JWT_SECRET=dev-secret-change-me
JWT_TTL=7d

# Anti-sniping. A bid inside SOFT_CLOSE_WINDOW_MS of the end moves the
# close to SOFT_CLOSE_EXTEND_MS from the moment it landed.
SOFT_CLOSE_WINDOW_MS=15000
SOFT_CLOSE_EXTEND_MS=30000

# How long a winner holds the item before it rolls down to the next bidder.
CHECKOUT_TTL_MS=900000

# Bids per second, per bidder and per address.
BID_RATE_MAX=2
BID_RATE_WINDOW_MS=1000
BID_RATE_IP_MAX=12

# Refuses a single bid above this. A typo, not a bid.
MAX_BID_CENTS=100000000

# 'local' writes to ./uploads and serves it from the API. 'cloudinary'
# needs the three credentials below and never touches the API's disk.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=uploads
MEDIA_MAX_BYTES=8388608
MEDIA_MAX_PER_ITEM=8
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=oction

# Mail. 'log' prints the message to the terminal so verification and
# password reset work with nothing configured - the link is in stdout.
# 'resend' needs the API key. 'silent' discards (used by the tests).
MAIL_DRIVER=log
MAIL_FROM=Oction <no-reply@oction.test>
# RESEND_API_KEY=

# Where the links in those emails point.
APP_URL=http://localhost:5175

# Sign-in and registration limits. The address bucket is charged on
# every attempt; the account bucket only on failures.
AUTH_RATE_IP_MAX=20
AUTH_RATE_IP_WINDOW_MS=60000
AUTH_RATE_ACCOUNT_MAX=10
AUTH_RATE_ACCOUNT_WINDOW_MS=900000

# How long a replayed bid returns its original answer.
IDEMPOTENCY_TTL_MS=600000

# How far ahead of a close the watchlist notice goes out.
CLOSING_SOON_LEAD_MS=300000

# Single-use link lifetimes.
VERIFY_TTL_MS=86400000
RESET_TTL_MS=3600000
