# Copy to .env. Everything here has a working default except the secret.
PORT=4200
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/oction
REDIS_URL=redis://127.0.0.1:6379

# Sign your own. A shared development secret in production means anyone
# can mint a session for anyone.
JWT_SECRET=dev-secret-change-me
JWT_TTL=7d

# Anti-sniping. A bid inside SOFT_CLOSE_WINDOW_MS of the end moves the
# close to SOFT_CLOSE_EXTEND_MS from the moment it landed.
SOFT_CLOSE_WINDOW_MS=15000
SOFT_CLOSE_EXTEND_MS=30000

# How long a winner holds the item before it rolls down to the next bidder.
CHECKOUT_TTL_MS=900000

# Bids per second, per bidder and per address.
BID_RATE_MAX=2
BID_RATE_WINDOW_MS=1000
BID_RATE_IP_MAX=12

# Refuses a single bid above this. A typo, not a bid.
MAX_BID_CENTS=100000000

# 'local' writes to ./uploads and serves it from the API. 'cloudinary'
# needs the three credentials below and never touches the API's disk.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=uploads
MEDIA_MAX_BYTES=8388608
MEDIA_MAX_PER_ITEM=8
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=oction
